<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.magnezis.inversiones.magnezis.controller.DashboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título y sesión -->
    <HBox spacing="10.0">
        <VBox spacing="4.0">
            <Label style="-fx-font-weight: bold;" text="Dashboard-Usuarios">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>
            <Label fx:id="lblSesion" text="Bienvenudo" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCerrarSesion" text="Cerrar sesión" />
    </HBox>

    <!-- Panel principal dividido en Formulario y Tabla -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- Formulario Izquierdo -->
        <VBox prefWidth="220.0" spacing="10.0">
            <Label text="Nombre Completo:" />
            <TextField fx:id="txtNombre" promptText="Magno Solis" />

            <Label text="Username:" />
            <TextField fx:id="txtUsername" promptText="magnito" />

            <Label text="Correo:" />
            <TextField fx:id="txtCorreo" promptText="magno@gmail.com" />

            <Label text="Contraseña:" />
            <PasswordField fx:id="txtPassword" promptText="••••••••" />

            <Label text="Rol asignado:" />
            <ComboBox fx:id="cmbRoles" prefWidth="220.0" promptText="Seleccionar rol..." />

            <!-- Botones de Acción -->
            <VBox spacing="8.0">
                <padding>
                    <Insets top="15.0" />
                </padding>
                <HBox spacing="10.0">
                    <Button onAction="#handleGuardar" prefWidth="105.0" text="Guardar" />
                    <Button onAction="#handleLimpiar" prefWidth="105.0" text="Actualizar" />
                </HBox>
                <Button onAction="#handleEliminar" prefWidth="220.0" text="Eliminar" />
            </VBox>
        </VBox>

        <!-- Tabla Derecha -->
        <TableView fx:id="tblUsuarios" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre" />
                <TableColumn fx:id="colUsername" prefWidth="120.0" text="Username" />
                <TableColumn fx:id="colCorreo" prefWidth="170.0" text="Correo" />
                <TableColumn fx:id="colRol" prefWidth="110.0" text="Rol" />
            </columns>
        </TableView>

    </HBox>
</VBox>
