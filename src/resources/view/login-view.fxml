<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="565.0" prefWidth="829.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.magnezis.inversiones.magnezis.controller.LoginController">
   <children>
      <Label text="LOGIN" style="-fx-font-size: 60px; -fx-font-weight: bold;">
         <VBox.margin>
            <Insets bottom="30.0" />
         </VBox.margin>
      </Label>
      <Label text="Correo Electrónico" />
      <TextField fx:id="txtCorreo" maxWidth="224.0" promptText="correo@ejemplo.com" />
      <Label text="Contraseña">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <PasswordField fx:id="txtPassword" maxWidth="224.0" onAction="#handleLogin" />
      <Button mnemonicParsing="false" onAction="#handleLogin" text="Iniciar Sesión">
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>